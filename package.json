{
  "name": "run-template-3d-react",
  "version": "1.0.0",
  "description": "Three.js + React UI + Vite + TypeScript template with RundotGameAPI integration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "_build": "tsc && vite build",
    "build": "npm run _build",
    "build:bundled": "cross-env RUNDOT_GAME_DISABLE_EMBEDDED_LIBS=true npm run _build",
    "preview": "vite preview",
    "deploy": "npm run build && rundot deploy",
    "format": "prettier \"{src,public}/**/*.{ts,tsx,js,jsx,json,css,html}\" --write",
    "format:check": "prettier \"{src,public}/**/*.{ts,tsx,js,jsx,json,css,html}\" --check",
    "gen:identity": "node scripts/run-ts.mjs scripts/gen-identity.ts",
    "sim:probe": "node scripts/run-ts.mjs scripts/sim-probe.ts",
    "test:determinism": "node scripts/run-ts.mjs scripts/determinism-test.ts",
    "test:network": "node scripts/run-ts.mjs scripts/network-test.ts",
    "test:perf": "node scripts/run-ts.mjs scripts/perf-test.ts",
    "bake:previews": "node scripts/run-ts.mjs bake/make-previews.ts",
    "bake": "node scripts/run-ts.mjs bake/bake-map.ts",
    "bake:route1": "node scripts/run-ts.mjs bake/bake-map.ts route1 && npm run gen:identity && npm run test:colliders",
    "test:colliders:all": "node scripts/run-all-colliders.mjs",
    "test:route": "node scripts/run-ts.mjs scripts/route-probe.ts",
    "test:colliders": "node scripts/run-ts.mjs scripts/collider-audit.ts",
    "test:outage": "node scripts/run-ts.mjs scripts/outage-test.ts",
    "test:lobby": "node scripts/run-ts.mjs scripts/lobby-test.ts",
    "test:monsters": "node scripts/run-ts.mjs scripts/monster-test.ts",
    "test:getup": "node scripts/run-ts.mjs scripts/getup-test.ts",
    "test:city": "node scripts/run-ts.mjs scripts/city-test.ts",
    "test:slime": "node scripts/run-ts.mjs scripts/slime-test.ts",
    "test:claws": "node scripts/run-ts.mjs scripts/claw-test.ts",
    "test:bots": "node scripts/run-ts.mjs scripts/bot-test.ts",
    "test:rejoin": "node scripts/run-ts.mjs scripts/rejoin-test.ts",
    "test:names": "node scripts/run-ts.mjs scripts/names-test.ts",
    "test:audio": "node scripts/run-ts.mjs scripts/audio-events-test.ts",
    "audio:estimate": "node scripts/run-ts.mjs scripts/generate-audio.ts --estimate",
    "audio:generate": "node scripts/run-ts.mjs scripts/generate-audio.ts"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "three.js",
    "RUN.game"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.txt",
  "devDependencies": {
    "@osmix/pbf": "^0.0.10",
    "@revenuecat/purchases-js": "^1.70.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "~0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "firebase": "^12.12.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "5.28.1",
    "@series-inc/rundot-syncplay": "5.28.0-beta.5",
    "@series-inc/stowkit-packer-gui": "^0.1.1",
    "@series-inc/stowkit-three-loader": "^0.1.43",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@series-inc/rundot-game-sdk"
    ]
  }
}
